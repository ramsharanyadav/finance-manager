# Application
APP_NAME="Finance Manager API"
APP_VERSION=1.0.0
APP_ENV=development
DEBUG=true

# API
API_V1_PREFIX=/api/v1

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=finance_manager
DB_USER=finance_user
DB_PASSWORD=test@123

# Connection Pool
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# JWT settings
JWT_SECRET_KEY=PASTE_YOUR_GENERATED_SECRET_HERE

JWT_ALGORITHM=HS256
JWT_ISSUER=test-api

ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=14