# Application
APP_NAME="Finance Manager API"
APP_VERSION=1.0.0
APP_ENV=development
DEBUG=true

# API
API_V1_PREFIX=/api/v1

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=finance_manager
